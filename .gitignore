# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 一時生成物（PDF目視確認用の中間ファイルなど）
/tmp/

# Claude Code のローカル固有ファイル。
# 将来 .claude/settings.json や .claude/skills/ を共有する余地を残すため、
# .claude/ 全体ではなく個別に除外する。
/.claude/launch.json
/.claude/.cc-writes/
